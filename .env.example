# Facebook Session State (Optional locally if facebook_session.json is present)
FB_STORAGE_STATE=

# Google Gemini API Key for Auto AI Caption & Hashtag Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Notifications (Optional - To receive alerts on your phone)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to "false" if you want to see browser UI while running locally
HEADLESS=true
